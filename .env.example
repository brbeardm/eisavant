# Copy to .env for local development. NEVER commit real secrets.

# Admin (owner) connection — used ONLY by migrations (creates schema + roles).
DATABASE_URL=postgresql://postgres:CHANGE_ME@host:5432/railway

# Application connection — non-privileged role, subject to row-level security.
# The migration creates this role using APP_DB_PASSWORD.
APP_DATABASE_URL=postgresql://eisavant_app:CHANGE_ME@host:5432/railway
APP_DB_PASSWORD=CHANGE_ME

# Auth
JWT_SECRET=CHANGE_ME_64_RANDOM_CHARS
JWT_EXPIRES_IN=2h

# Server
PORT=8080
NODE_ENV=development

# Initial admin user (consumed by `npm run seed`)
SEED_ADMIN_EMAIL=admin@eisavant.com
SEED_ADMIN_PASSWORD=CHANGE_ME
